__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
dist/

# ── 测试与覆盖率 ──
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ── IDE / 编辑器 ──
.idea/
.vscode/
*.swp
*.swo

# ── 环境变量与密钥 ──
.env
.env.*
!.env.example

